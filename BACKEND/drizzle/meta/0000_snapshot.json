      "checkConstraints": {
        "posts_kind_check": {
          "name": "posts_kind_check",
          "value": "\"posts\".\"kind\" IN ('original', 'reply', 'repost')"
        },
        "posts_kind_relationship_check": {
          "name": "posts_kind_relationship_check",
          "value": "(\n        (\"posts\".\"kind\" = 'original'\n          AND \"posts\".\"reply_to_id\" IS NULL\n          AND \"posts\".\"repost_of_id\" IS NULL)\n\n        OR\n\n        (\"posts\".\"kind\" = 'reply'\n          AND \"posts\".\"reply_to_id\" IS NOT NULL\n          AND \"posts\".\"repost_of_id\" IS NULL)\n\n        OR\n\n        (\"posts\".\"kind\" = 'repost'\n          AND \"posts\".\"reply_to_id\" IS NULL\n          AND \"posts\".\"repost_of_id\" IS NOT NULL)\n      )"
        },
        "posts_text_check": {
          "name": "posts_text_check",
          "value": "(\n        (\n          \"posts\".\"kind\" IN ('original', 'reply')\n          AND \"posts\".\"text\" IS NOT NULL\n          AND \"posts\".\"text\" = BTRIM(\"posts\".\"text\")\n          AND CHAR_LENGTH(\"posts\".\"text\") BETWEEN 1 AND 280\n        )\n        OR\n        (\n          \"posts\".\"kind\" = 'repost'\n          AND \"posts\".\"text\" IS NULL\n        )\n      )"
        }
      },
